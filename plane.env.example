# Plane Community Edition v1.4.3 - environment for Dokploy
# Paste into the Dokploy "Environment" tab, then replace every CHANGE_ME.
#
# Rules of thumb
#   - Use alphanumeric secrets (A-Z a-z 0-9). $ and # have special meaning in
#     .env / compose interpolation, and DB passwords are embedded in URLs.
#   - Generate secrets with: openssl rand -hex 32 (one per key, never reuse)
#   - DATABASE_URL / AMQP_URL are derived from the POSTGRES_* / RABBITMQ_*
#     values, so each password is written only once below.

# ---------- Release ----------
# Pin the version for reproducible deploys. Use "stable" to follow latest.
APP_RELEASE=v1.4.3

# ---------- Public URL ----------
WEB_URL=https://plane.pawaox4th.com
CORS_ALLOWED_ORIGINS=https://plane.pawaox4th.com

# Caddy inside the proxy container stays on plain HTTP.
# Dokploy's Traefik terminates TLS, so Caddy must never request a certificate.
SITE_ADDRESS=:80
TRUSTED_PROXIES=0.0.0.0/0
CERT_EMAIL=
CERT_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
CERT_ACME_DNS=

# ---------- Application ----------
DEBUG=0
GUNICORN_WORKERS=1
FILE_SIZE_LIMIT=5242880
API_KEY_RATE_LIMIT=60/minute
AUTHENTICATION_RATE_LIMIT=10/minute
WEBHOOK_ALLOWED_IPS=
WEBHOOK_ALLOWED_HOSTS=

# ---------- Secrets (CHANGE ME - a different value for each key) ----------
SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
LIVE_SERVER_SECRET_KEY=CHANGE_ME_openssl_rand_hex_32_other_value

# ---------- PostgreSQL ----------
POSTGRES_USER=plane
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=plane
POSTGRES_PORT=5432
PGHOST=plane-db
PGDATABASE=plane
PGDATA=/var/lib/postgresql/data
# Optional. Leave empty: the compose file derives
# postgresql://POSTGRES_USER:POSTGRES_PASSWORD@PGHOST:POSTGRES_PORT/POSTGRES_DB
# Fill this only when pointing at a database outside this stack.
DATABASE_URL=

# ---------- Redis ----------
REDIS_HOST=plane-redis
REDIS_PORT=6379
# Optional. Leave empty to derive redis://REDIS_HOST:REDIS_PORT/
REDIS_URL=

# ---------- RabbitMQ ----------
RABBITMQ_HOST=plane-mq
RABBITMQ_PORT=5672
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=CHANGE_ME_rabbitmq_password
RABBITMQ_VHOST=plane
# Optional. Leave empty to derive
# amqp://RABBITMQ_USER:RABBITMQ_PASSWORD@RABBITMQ_HOST:RABBITMQ_PORT/RABBITMQ_VHOST
AMQP_URL=

# ---------- Object storage (MinIO in this stack) ----------
# Switch USE_MINIO to 0 and point AWS_S3_ENDPOINT_URL to an external S3
# endpoint only if you move storage out of this machine.
USE_MINIO=1
AWS_REGION=
AWS_ACCESS_KEY_ID=CHANGE_ME_minio_access_key
AWS_SECRET_ACCESS_KEY=CHANGE_ME_minio_secret_key
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
AWS_S3_BUCKET_NAME=uploads
MINIO_ENDPOINT_SSL=0

# ---------- Live server ----------
API_BASE_URL=http://api:8000
